# --- Atlas frontend environment ---
# Copy to .env.local for local overrides. Vite only exposes VITE_* vars.

# Base URL for the backend API. Leave unset to use the dev proxy at /api.
VITE_API_BASE_URL=/api

# MapLibre style URL. Defaults to the MapLibre demo tiles if unset.
VITE_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json
