{
  "name": "atlas",
  "version": "0.1.0",
  "private": true,
  "description": "Atlas — explainable data-center site screening for Massachusetts",
  "scripts": {
    "predev": "node scripts/copy-maplibre-worker.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-maplibre-worker.mjs",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "setup:node": "bash scripts/setup-node.sh",
    "setup:pipeline": "python3 -m venv .venv-pipeline && .venv-pipeline/bin/pip install -r pipeline/requirements.txt",
    "pipeline": ".venv-pipeline/bin/python pipeline/build_hexes.py",
    "assumptions": ".venv-pipeline/bin/python pipeline/build_assumptions.py",
    "briefs-cache": "node scripts/build-briefs-cache.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "3.1156.0",
    "@deck.gl/core": "9.4.0",
    "@deck.gl/geo-layers": "9.4.0",
    "@deck.gl/layers": "9.4.0",
    "@deck.gl/maplibre": "9.4.0",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-scroll-area": "1.4.0",
    "@radix-ui/react-separator": "1.2.0",
    "@radix-ui/react-slider": "1.6.1",
    "@radix-ui/react-switch": "1.4.1",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@turf/turf": "7.4.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "h3-js": "4.5.0",
    "lucide-react": "1.61.0",
    "maplibre-gl": "6.15.0",
    "motion": "14.6.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.10.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/geojson": "7946.0.16",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "fast-check": "4.10.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
